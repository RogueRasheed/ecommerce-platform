# LEGACY Express API — being replaced by Medusa. Copy to server/.env.
PORT=3000
MONGO_URI=mongodb://localhost:27017/amineru
JWT_SECRET=change-me-long-random-string

# Paystack SECRET key (server only, never expose to the client)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key

# Where Paystack sends customers back after paying, and which origins may call the API
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Sanity (only used by the legacy product/stock flow)
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_TOKEN=
