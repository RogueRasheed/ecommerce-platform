@@ -0,0 +1,12 @@
+# Copy to client/.env — only VITE_ variables reach the browser, so never put
+# secret keys here (Paystack SECRET key, admin passwords, etc.).
+
+# Medusa backend (Medusa Admin > Settings > Publishable API Keys)
+VITE_MEDUSA_BACKEND_URL=http://localhost:9000
+VITE_MEDUSA_PUBLISHABLE_KEY=pk_your_medusa_publishable_key
+
+# Paystack PUBLIC key (safe for the browser). Use pk_test_... in development.
+VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
+
+# Legacy Express API — remove once checkout, orders and admin run on Medusa
+VITE_API_BASE_URL=http://localhost:3000/api
