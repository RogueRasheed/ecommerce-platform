# Copy to amineru-medusa/apps/backend/.env
DATABASE_URL=postgres://postgres:postgres@localhost:5432/amineru-medusa

# Comma-separated origins allowed to call each part of the API
STORE_CORS=http://localhost:5173
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000

# Generate with: openssl rand -hex 32
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# Paystack SECRET key, used by the medusa-payment-paystack provider
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
